#!/bin/bash
# Permanence post-commit: refresh the derived CONTENTS.md indexes after every commit.
# Must never block or noise up a commit — best-effort, silent.
PERMA="${PERMA_DIR:-$HOME/permanence}"
"$PERMA/runtime/generate-contents.sh" --quiet >/dev/null 2>&1 || true

# Keep the /perma-search semantic index fresh — INCREMENTAL (only the .md files this commit
# touched) + BACKGROUNDED (never blocks the commit) + best-effort. No-ops unless perma-search
# is set up (its venv exists). Local embeddings, zero API.
SEARCH_PY="$PERMA/runtime/search/.venv/bin/python"
if [ -x "$SEARCH_PY" ]; then
  CHANGED=$(git -C "$PERMA" diff --name-only --diff-filter=ACMRD HEAD~1 HEAD -- '*.md' 2>/dev/null)
  if [ -n "$CHANGED" ]; then
    ( cd "$PERMA" && printf '%s\n' "$CHANGED" | sed "s#^#$PERMA/#" \
        | xargs "$SEARCH_PY" runtime/search/perma-search.py update ) >/dev/null 2>&1 &
  fi
fi

# [stub — orchestration pressure gauge, build-sequence Phase 4c]
# Deliberately NOT implemented yet: per _meta/generative-orchestration-pass.md the gauge
# is wired only once /perma-orchestrate is proven by hand (apophenia guard). When it lands,
# this hook gains a cheap convergence-estimate update + threshold nudge. Do not add early.
exit 0
